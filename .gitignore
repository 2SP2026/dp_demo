# Ignore everything in the root directory by default
*

# Allow exploring directories (necessary for Git to see inside them)
!*/

# Specifically allow our target tracking directories and files
!scripts/
!scripts/**
!Analysis/
!Analysis/**
!.gitignore
!requirements.txt

# Explicitly ignore the virtual environment (use requirements.txt instead)
.venv/
/.venv/

# Ignore standard python noise inside the allowed directories
__pycache__/
*.pyc
~$*
